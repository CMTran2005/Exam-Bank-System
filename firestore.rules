rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // HÀM TIỆN ÍCH (FUNCTIONS)
    // ---------------------------------------------------------
    
    // Kiểm tra người dùng đã đăng nhập chưa
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Kiểm tra xem dữ liệu cập nhật có thay đổi một trường cụ thể không
    function isUnmodified(field) {
      return !(field in request.resource.data) || 
             request.resource.data[field] == resource.data[field];
    }
    
    // Lấy thông tin role của người dùng hiện tại từ bảng users
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Kiểm tra xem người dùng có vai trò Giáo viên hoặc Admin không
    function isTeacherOrAdmin() {
      return getUserRole() == "teacher" || getUserRole() == "admin";
    }

    // ---------------------------------------------------------
    // QUY TẮC BẢO MẬT THEO TỪNG BẢNG (COLLECTIONS)
    // ---------------------------------------------------------

    // 1. BẢNG USERS (Người dùng)
    match /users/{userId} {
      // Ai cũng có thể đọc thông tin cơ bản (cần thiết cho class, leaderboard)
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Mở quyền update để Phụ huynh có thể cập nhật trường linkedParents của Học sinh khi liên kết tài khoản
      allow update: if isAuthenticated();
      allow delete: if false; // Không cho phép xóa user trực tiếp từ client

      // Sổ tay câu sai (Error Notebook)
      match /error_notebook/{questionId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Lời chúc động viên (Encouragements - Phase 5)
      match /encouragements/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 2. BẢNG EXAMS (Đề thi)
    match /exams/{examId} {
      // Học sinh và phụ huynh được phép ĐỌC đề thi
      allow read: if isAuthenticated();
      // CHỈ GIÁO VIÊN/ADMIN mới được tạo, sửa, xóa đề thi của chính mình
      allow create: if isAuthenticated() && isTeacherOrAdmin() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && isTeacherOrAdmin() && resource.data.uid == request.auth.uid;
    }

    // BẢNG QUESTIONS (Câu hỏi trong đề thi)
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isTeacherOrAdmin() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && isTeacherOrAdmin() && resource.data.uid == request.auth.uid;
    }

    // BẢNG FOLDERS (Thư mục đề thi)
    match /folders/{folderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isTeacherOrAdmin() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && isTeacherOrAdmin() && resource.data.uid == request.auth.uid;
    }

    // 3. BẢNG EXAM_ATTEMPTS (Lượt thi / Bài làm)
    match /exam_attempts/{attemptId} {
      // Cho phép mọi người dùng đã đăng nhập có quyền đọc/ghi bài làm
      // (Do logic chấm điểm đã chuyển lên Server, việc mở quyền ghi ở đây giúp tránh các lỗi permission)
      allow read, write: if isAuthenticated();
    }

    // 4. BẢNG CLASSES (Lớp học)
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isTeacherOrAdmin();
      allow update: if isAuthenticated() && (
        (isTeacherOrAdmin() && resource.data.teacherId == request.auth.uid) || 
        (getUserRole() == "student") // Cho phép học sinh update studentCount khi join
      );
      allow delete: if isAuthenticated() && isTeacherOrAdmin() && resource.data.teacherId == request.auth.uid;
    }

    // 5. BẢNG FLASHCARDS
    match /flashcards/{flashcardId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 6. BẢNG EXAM_SESSIONS (Phiên soạn thảo chung)
    match /exam_sessions/{sessionId} {
      allow read, write: if isAuthenticated() && isTeacherOrAdmin();
    }

    // 7. BẢNG DRAFTS (Bản nháp cục bộ trên Cloud)
    match /drafts/{draftId} {
      // Chỉ user đó mới được đọc, ghi bản nháp của chính mình
      allow read, write: if isAuthenticated() && request.auth.uid == draftId;
    }

    // 8. BẢNG CLASS_MEMBERS (Học sinh trong lớp)
    match /class_members/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // 9. BẢNG SYSTEM (Cấu hình hệ thống chung)
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTeacherOrAdmin();
    }

    // 10. BẢNG BADGES (Huy hiệu)
    match /badges/{badgeId} {
      allow read, write: if isAuthenticated();
    }

    // 11. BẢNG TRASH_EXAMS (Thùng rác đề thi)
    match /trash_exams/{examId} {
      allow create: if isAuthenticated() && isTeacherOrAdmin() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && isTeacherOrAdmin() && resource.data.uid == request.auth.uid;
    }

    // 12. BẢNG LEAGUE_GROUPS (Giải đấu tuần)
    match /leagueGroups/{groupId} {
      allow read, write: if isAuthenticated();
      
      match /leaderboard/{userId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
